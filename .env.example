# Ethanel — environment template
#
# Copy to `.env` and fill in. `.env` and `.env.*` are gitignored; this file is
# the one exception, so it must never contain a real secret.
#
# Every key below is marked with who reads it. Keys marked NOT YET READ are
# documented here deliberately: they are the credentials the Neon and Clerk
# projects issue, recorded now so the values have somewhere to live, but no
# code consumes them yet. That is honest rather than tidy — see the note under
# each block for what has to exist before it does.
#
# Environment is validated at startup and fails fast (packages/config/src/env.ts).
# A missing key names itself in the service that needs it rather than failing
# somewhere generic.


# ---------------------------------------------------------------- runtime ---
# Read by: every service, via `baseEnvSchema`.

# development | test | production. Never hard-code production in an image.
NODE_ENV=development

# Set by the Helm chart from the image tag so a running pod can say what it is.
APP_VERSION=dev

PORT=3000


# --------------------------------------------------------------- database ---
# Read by: `databaseEnvSchema` (packages/config). Supplied by Neon.
#
# Neon issues two strings for the same database and they are not
# interchangeable:
#
#   DATABASE_URL           pooled, through PgBouncer. What the application uses.
#                          Has `-pooler` in the host. Safe under many short-lived
#                          serverless connections, which is the whole reason it
#                          exists.
#
#   DATABASE_URL_UNPOOLED  a direct connection. What migrations use. Schema
#                          changes need session-level state (advisory locks,
#                          CREATE INDEX CONCURRENTLY) that a transaction pooler
#                          does not carry, so a migration run through the pooled
#                          string fails in ways that are hard to read.
#
# Both must end with `?sslmode=require`. Neon rejects an unencrypted connection,
# and a driver that silently retries without TLS is worse than one that fails.

DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/ethanel?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/ethanel?sslmode=require


# ------------------------------------------------------------------- auth ---
# NOT YET READ BY ANY CODE. Supplied by Clerk.
#
# There is no authenticated surface in this repo yet. `apps/web` is the public
# marketing site, and an ESLint import zone fails the build if anything under
# `app/(marketing)` imports an authenticated module (D-68) — so Clerk cannot be
# wired into the app that exists today without breaking the boundary that keeps
# the marketing site provably schema-free.
#
# What has to happen first: an `app/(app)` route group with its own layout and
# proxy matcher. Once that exists, these keys are read there and nowhere else.
#
# The publishable key is exposed to the browser and is not a secret. The secret
# key and the webhook signing secret are, and must never reach a NEXT_PUBLIC_
# name — the prefix is what inlines a value into the client bundle, so a secret
# renamed that way is published rather than leaked.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Verifies inbound Clerk webhooks (user and organization sync). Without it a
# handler cannot tell a real event from anything that can reach the endpoint.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_REPLACE_ME

# Where Clerk sends people. Kept in env rather than hard-coded so the routes can
# move without a redeploy of the auth config.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up


# ------------------------------------------------------------------ leads ---
# Read by: apps/web/lib/lead-sink.ts
#
# DEBT-08. `/demo` submissions are appended to a JSONL file because Q22 — which
# boundary owns a sales lead — is unanswered, and picking a CRM before that is
# decided is how an integration becomes permanent by accident.
#
# The browser suite sets this to a temp path. Leave it unset in development and
# leads land in `apps/web/.data/demo-leads.jsonl`.

# LEAD_SINK_PATH=/absolute/path/to/demo-leads.jsonl


# ------------------------------------------------------------------ tests ---
# Read by: apps/web/playwright.config.ts. Optional, and only for local runs.
#
# Set PLAYWRIGHT_EXECUTABLE_PATH when the pinned Playwright expects a browser
# build the machine does not have — a container that ships Chromium under
# /opt/pw-browsers is the usual case. Without it, `playwright test` fails at
# launch with an "Executable doesn't exist" error that looks like a code fault
# and is not one.

# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_EXECUTABLE_PATH=/opt/pw-browsers/chromium
# PLAYWRIGHT_CHANNEL=chromium
