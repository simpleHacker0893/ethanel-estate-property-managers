{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Ethanel service values",
  "description": "Shape validation, which is a different job from D-34's gates. The schema catches a typo like `resource:` for `resources:`; _validate.tpl catches a deliberately missing gate and names the decision. Both are needed: a typo that makes a gate vanish would otherwise be reported as a missing gate rather than as a typo.",
  "type": "object",
  "required": ["image", "containerPort", "rollout", "autoscaling", "service"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" }
      }
    },
    "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "replicaCount": { "type": ["integer", "null"], "minimum": 1 },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "probes": {
      "type": "object",
      "required": ["readiness", "liveness"],
      "properties": {
        "readiness": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" },
        "startup": { "$ref": "#/definitions/probe" }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/resourceSide" },
        "limits": { "$ref": "#/definitions/resourceSide" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "egress"],
      "properties": {
        "enabled": { "type": "boolean", "const": true },
        "ingress": { "type": "array" },
        "egress": { "type": "array" }
      }
    },
    "autoscaling": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": ["integer", "null"], "minimum": 1 },
        "maxReplicas": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "anyOf": [
        { "required": ["httpGet"] },
        { "required": ["exec"] },
        { "required": ["tcpSocket"] }
      ]
    },
    "resourceSide": {
      "type": "object",
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": { "type": ["string", "number"] },
        "memory": { "type": "string" }
      }
    }
  }
}
